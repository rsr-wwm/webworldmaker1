DirectoryIndex index.html
ErrorDocument 404 /404.html
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect legacy aliases before Apache's DirectorySlash handler can turn
  # /alias into a second redirect to /alias/. These are exact, intentional
  # routes only; unknown paths must continue to return 404.
  RewriteRule ^partners/partner-program/?$ /partners/ [R=301,L,NE]
  RewriteRule ^contact-us/?$ /contact/ [R=301,L,NE]
  RewriteRule ^company/contact/?$ /contact/ [R=301,L,NE]
  RewriteRule ^company/about-us/?$ /company/about/ [R=301,L,NE]
  RewriteRule ^about(?:-us)?/?$ /company/about/ [R=301,L,NE]
  RewriteRule ^careers/?$ /company/careers/ [R=301,L,NE]
  RewriteRule ^seo-tools/?$ /search-growth/seo-services/ [R=301,L,NE]
  RewriteRule ^roi-calculator/?$ /pricing/ [R=301,L,NE]
  RewriteRule ^diagnostics/?$ /contact/ [R=301,L,NE]
  RewriteRule ^search-growth/aeo/?$ /search-growth/aeo-services/ [R=301,L,NE]
  RewriteRule ^search-growth/geo/?$ /search-growth/geo-services/ [R=301,L,NE]
  RewriteRule ^search-growth/seo/?$ /search-growth/seo-services/ [R=301,L,NE]

  # Mark hashed Astro assets before the optional Brotli rewrite. This is more
  # reliable on shared Apache/CDN stacks than relying only on SetEnvIf.
  RewriteRule ^assets/ - [E=wwm_immutable:1]

  # Serve a pre-compressed sibling only when the browser accepts Brotli.
  RewriteCond %{HTTP:Accept-Encoding} br
  RewriteCond %{REQUEST_FILENAME}.br -s
  RewriteRule ^(.+)\.(html|js|mjs|css|svg|json|xml|txt)$ $1.$2.br [QSA,L]

  # Astro's canonical format uses directory URLs with a trailing slash.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.+)$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs)\.br$">
    Header set Content-Type "text/javascript; charset=utf-8"
    Header set Content-Encoding "br"
    Header append Vary "Accept-Encoding"
  </FilesMatch>
  <FilesMatch "\.css\.br$">
    Header set Content-Type "text/css; charset=utf-8"
    Header set Content-Encoding "br"
    Header append Vary "Accept-Encoding"
  </FilesMatch>
  <FilesMatch "\.html\.br$">
    Header set Content-Type "text/html; charset=utf-8"
    Header set Content-Encoding "br"
    Header append Vary "Accept-Encoding"
  </FilesMatch>
  <FilesMatch "\.svg\.br$">
    Header set Content-Type "image/svg+xml; charset=utf-8"
    Header set Content-Encoding "br"
    Header append Vary "Accept-Encoding"
  </FilesMatch>
  <FilesMatch "\.json\.br$">
    Header set Content-Type "application/json; charset=utf-8"
    Header set Content-Encoding "br"
    Header append Vary "Accept-Encoding"
  </FilesMatch>
  <FilesMatch "\.xml\.br$">
    Header set Content-Type "application/xml; charset=utf-8"
    Header set Content-Encoding "br"
    Header append Vary "Accept-Encoding"
  </FilesMatch>
  <FilesMatch "\.txt\.br$">
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Content-Encoding "br"
    Header append Vary "Accept-Encoding"
  </FilesMatch>

  # Astro /assets files are content-hashed. Public images and documents are not.
  Header always set Cache-Control "public, max-age=31536000, immutable" env=wwm_immutable
  <FilesMatch "\.(html|json|xml|txt)(?:\.br)?$">
    Header always set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "(llms.*\.txt|robots\.txt|sitemap.*\.xml)(?:\.br)?$">
    Header always set Access-Control-Allow-Origin "*"
    Header always set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <Files "robots.txt">
    Header always set Access-Control-Allow-Origin "*"
    Header always set Cache-Control "public, max-age=3600, must-revalidate"
  </Files>
  <Files "robots.txt.br">
    Header always set Access-Control-Allow-Origin "*"
    Header always set Cache-Control "public, max-age=3600, must-revalidate"
  </Files>
  <Files "llms.txt">
    Header always set Access-Control-Allow-Origin "*"
    Header always set Cache-Control "public, max-age=3600, must-revalidate"
  </Files>
  <Files "llms.txt.br">
    Header always set Access-Control-Allow-Origin "*"
    Header always set Cache-Control "public, max-age=3600, must-revalidate"
  </Files>
  <Files "llms-full.txt">
    Header always set Access-Control-Allow-Origin "*"
    Header always set Cache-Control "public, max-age=3600, must-revalidate"
  </Files>
  <Files "llms-full.txt.br">
    Header always set Access-Control-Allow-Origin "*"
    Header always set Cache-Control "public, max-age=3600, must-revalidate"
  </Files>

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
  # Keep subdomains out until every subdomain has been verified for HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header unset X-Powered-By
</IfModule>
