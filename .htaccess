# WebWorldMaker — Hostinger / Apache 0.1% Genius Server Configuration
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── 1. Serve Pre-Compressed Brotli (.br) Assets ─────────────────────
  # Serve Brotli CSS, JS, SVG, JSON, XML files if browser accepts Brotli and .br file exists
  RewriteCond %{HTTP:Accept-Encoding} br
  RewriteCond %{REQUEST_FILENAME}\.br -s
  RewriteRule ^(.*)\.(js|css|svg|json|xml|txt)$ $1\.$2\.br [QSA,L]

  # ── 2. Canonical Trailing Slash Normalization ───────────────────────
  # Redirect requests for directories without trailing slashes (301 Permanent)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# ── 3. MIME Types & Content Encodings for Brotli Assets ─────────────────
<IfModule mod_headers.c>
  # Correct Content-Encoding for pre-compressed Brotli files
  <FilesMatch "\.js\.br$">
    Header set Content-Type "application/javascript; charset=utf-8"
    Header set Content-Encoding "br"
    Header append Vary "Accept-Encoding"
  </FilesMatch>
  <FilesMatch "\.css\.br$">
    Header set Content-Type "text/css; charset=utf-8"
    Header set Content-Encoding "br"
    Header append Vary "Accept-Encoding"
  </FilesMatch>
  <FilesMatch "\.svg\.br$">
    Header set Content-Type "image/svg+xml; charset=utf-8"
    Header set Content-Encoding "br"
    Header append Vary "Accept-Encoding"
  </FilesMatch>
  <FilesMatch "\.json\.br$">
    Header set Content-Type "application/json; charset=utf-8"
    Header set Content-Encoding "br"
    Header append Vary "Accept-Encoding"
  </FilesMatch>
  <FilesMatch "\.xml\.br$">
    Header set Content-Type "application/xml; charset=utf-8"
    Header set Content-Encoding "br"
    Header append Vary "Accept-Encoding"
  </FilesMatch>

  # ── 4. Immutable Caching for Static Assets (/assets/*) ───────────────
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # ── 5. AI/LLM Text Files CORS & Encoding ────────────────────────────
  <FilesMatch "(llms\.txt|llms-full\.txt|robots\.txt|sitemap.*\.xml)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # ── 6. Security Headers ───────────────────────────────────────────────
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # HSTS: site is HTTPS-only already (all canonical/OG URLs use https://) —
  # this just makes browsers enforce it, closing the downgrade window.
  # Start without `preload` until this has run cleanly for a while; adding
  # to the HSTS preload list is a one-way commitment.
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Locks down powerful browser APIs. geolocation stays allowed for same-origin
  # only — GlobalLocaleSelector.tsx uses navigator.geolocation (gated behind
  # cookie consent) for the "nearest location" feature; blocking it outright
  # would have silently broken that. camera/microphone/payment are genuinely
  # unused anywhere in this codebase (verified: no getUserMedia, no
  # PaymentRequest API calls) so those are safe to lock down fully.
  Header set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()"
</IfModule>
